# EIAAW Workforce — production web server (rendered by docker-entrypoint.sh).
# __PORT__ and __NGINX_CONF__ are substituted at boot. Security headers come
# from the app (SecurityHeaders middleware), so nginx adds none of its own.
worker_processes 2;
daemon off;
pid /tmp/nginx.pid;

events {
    worker_connections 1024;
}

http {
    include __NGINX_CONF__/mime.types;
    default_type application/octet-stream;
    access_log /dev/stdout;
    error_log /dev/stderr warn;
    sendfile on;
    server_tokens off;
    client_max_body_size 25m;

    client_body_temp_path /tmp/nginx-body;
    fastcgi_temp_path /tmp/nginx-fastcgi;
    proxy_temp_path /tmp/nginx-proxy;
    uwsgi_temp_path /tmp/nginx-uwsgi;
    scgi_temp_path /tmp/nginx-scgi;

    server {
        listen __PORT__;
        listen [::]:__PORT__;
        root /app/public;
        index index.php;
        charset utf-8;

        location / {
            try_files $uri $uri/ /index.php?$query_string;
        }

        location ~ \.php$ {
            try_files $uri =404;
            fastcgi_pass 127.0.0.1:9000;
            fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
            include __NGINX_CONF__/fastcgi_params;
            fastcgi_read_timeout 120s;
        }

        # Dotfiles stay private, except /.well-known (security.txt).
        location ~ /\.(?!well-known).* {
            deny all;
        }
    }
}
