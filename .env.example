# ─────────────────────────────────────────────────────────────────
# EIAAW Workforce — Environment Configuration
# ─────────────────────────────────────────────────────────────────
APP_NAME="EIAAW Workforce"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Kuala_Lumpur
APP_LOCALE=en

# Public marketing apex (Wk2): ep.eiaawsolutions.com
# Tenant subdomains: {slug}.ep.eiaawsolutions.com
APP_MARKETING_HOST=ep.eiaawsolutions.com
APP_TENANT_DOMAIN=ep.eiaawsolutions.com

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ─────────────────────────────────────────────────────────────────
# Database — Postgres on Railway (production), local Postgres (dev)
# Legacy MySQL config kept commented for reference only; the SaaS
# build is Postgres-only.
# ─────────────────────────────────────────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=eiaaw_workforce
DB_USERNAME=postgres
DB_PASSWORD=
DB_SCHEMA=public
DB_SSLMODE=prefer

# ─────────────────────────────────────────────────────────────────
# Cache, queue, sessions
# ─────────────────────────────────────────────────────────────────
BROADCAST_DRIVER=log
CACHE_DRIVER=redis
FILESYSTEM_DISK=r2
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false
# Cookie domain set to leading-dot apex so tenant subdomains share session
# (production only; for local dev keep blank)
SESSION_DOMAIN=

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ─────────────────────────────────────────────────────────────────
# Object storage — Cloudflare R2 (S3-compatible)
# ─────────────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=eiaaw-workforce
AWS_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
AWS_USE_PATH_STYLE_ENDPOINT=true

# ─────────────────────────────────────────────────────────────────
# Mail — Mailgun in production, Mailpit in local
# ─────────────────────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@eiaawsolutions.com"
MAIL_FROM_NAME="${APP_NAME}"

# ═════════════════════════════════════════════════════════════════
# SECRETS STRATEGY — EIAAW Workforce uses Infisical
# ═════════════════════════════════════════════════════════════════
# Raw secret values live in Infisical (project: eiaaw-workforce-prod).
# SecretsServiceProvider resolves `secret://` handles at boot via the
# aiob-app / eiaaw-workforce-app machine identity.
#
# The ONLY raw secrets in this .env are the Infisical bootstrap
# credentials below. Every other secret is a handle.
#
# See:
#   - config/secrets.php — resolve allow-list
#   - app/Services/Secrets/InfisicalResolver.php — Guzzle client
#   - app/Providers/SecretsServiceProvider.php — boot-time rewriter
#   - ~/.claude/skills/full-stack-engineer/references/eiaaw-deploy-playbook.md
#
# ─────────────────────────────────────────────────────────────────
INFISICAL_RESOLVER_ENABLED=false
INFISICAL_SITE_URL=https://app.infisical.com
INFISICAL_APP_CLIENT_ID=
INFISICAL_APP_CLIENT_SECRET=
INFISICAL_PROJECT_ID=
INFISICAL_ENVIRONMENT=prod
INFISICAL_CACHE_TTL=300
INFISICAL_REQUEST_TIMEOUT=5

# ─────────────────────────────────────────────────────────────────
# Stripe — billing (values resolved from Infisical in production)
# ─────────────────────────────────────────────────────────────────
STRIPE_KEY=secret://eiaaw-workforce-prod/prod/STRIPE_PUBLISHABLE_KEY
STRIPE_SECRET=secret://eiaaw-workforce-prod/prod/STRIPE_SECRET
STRIPE_WEBHOOK_SECRET=secret://eiaaw-workforce-prod/prod/STRIPE_WEBHOOK_SECRET
CASHIER_CURRENCY=usd
CASHIER_CURRENCY_LOCALE=en_US
# 14-day no-CC trial — converts to paid Starter tier on day 15 unless upgraded
STRIPE_TRIAL_DAYS=14

# Stripe Price IDs per tier × interval. Create via `php artisan stripe:sync-prices
# --apply` (sets both Stripe + Infisical), or update directly in the Infisical UI.
# Annual = monthly × 10 (2 months free). Starter $6/mo, Growth $14/mo, Scale $29/mo.
STRIPE_PRICE_STARTER_USD_MONTHLY=secret://eiaaw-workforce-prod/prod/STRIPE_PRICE_STARTER_USD_MONTHLY
STRIPE_PRICE_STARTER_USD_ANNUAL=secret://eiaaw-workforce-prod/prod/STRIPE_PRICE_STARTER_USD_ANNUAL
STRIPE_PRICE_GROWTH_USD_MONTHLY=secret://eiaaw-workforce-prod/prod/STRIPE_PRICE_GROWTH_USD_MONTHLY
STRIPE_PRICE_GROWTH_USD_ANNUAL=secret://eiaaw-workforce-prod/prod/STRIPE_PRICE_GROWTH_USD_ANNUAL
STRIPE_PRICE_SCALE_USD_MONTHLY=secret://eiaaw-workforce-prod/prod/STRIPE_PRICE_SCALE_USD_MONTHLY
STRIPE_PRICE_SCALE_USD_ANNUAL=secret://eiaaw-workforce-prod/prod/STRIPE_PRICE_SCALE_USD_ANNUAL

# ─────────────────────────────────────────────────────────────────
# AI assistant — Anthropic primary, OpenAI fallback
# ─────────────────────────────────────────────────────────────────
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=secret://eiaaw-workforce-prod/prod/ANTHROPIC_API_KEY
ANTHROPIC_MODEL_ROUTINE=claude-haiku-4-5-20251001
ANTHROPIC_MODEL_COMPLEX=claude-sonnet-4-6
OPENAI_API_KEY=secret://eiaaw-workforce-prod/prod/OPENAI_API_KEY
OPENAI_MODEL_ROUTINE=gpt-4o-mini
OPENAI_MODEL_COMPLEX=gpt-4o

# Per-tenant monthly AI spend caps (USD). Circuit breaker trips when exceeded.
AI_BUDGET_STARTER_USD=5
AI_BUDGET_GROWTH_USD=15
AI_BUDGET_SCALE_USD=40
AI_BUDGET_ENTERPRISE_USD=200

# ─────────────────────────────────────────────────────────────────
# Security & Backup
# ─────────────────────────────────────────────────────────────────
FORCE_HTTPS=false
BACKUP_ENCRYPTION_KEY=secret://eiaaw-workforce-prod/prod/BACKUP_ENCRYPTION_KEY
LOG_INTEGRITY_KEY=secret://eiaaw-workforce-prod/prod/LOG_INTEGRITY_KEY

# DR verification — point at a sidecar Postgres that can be clobbered weekly.
# Must NOT match the primary DB_HOST + DB_DATABASE (safety check in the command).
# Leave blank in dev; scheduler skips the restore test when unset.
TEST_RESTORE_DSN=secret://eiaaw-workforce-prod/prod/TEST_RESTORE_DSN

# ─────────────────────────────────────────────────────────────────
# Observability — Sentry (Session 12 Item I)
# ─────────────────────────────────────────────────────────────────
# Setup: composer require sentry/sentry-laravel, then create Infisical secret.
# See docs/OBSERVABILITY.md for the full activation runbook.
SENTRY_LARAVEL_DSN=secret://eiaaw-workforce-prod/prod/SENTRY_DSN
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1
SENTRY_ENVIRONMENT=production
# SENTRY_RELEASE is set by Railway from RAILWAY_GIT_COMMIT_SHA at deploy time.

# ─────────────────────────────────────────────────────────────────
# Threat Detection Thresholds
# ─────────────────────────────────────────────────────────────────
SECURITY_LOGIN_FAIL_THRESHOLD=5
SECURITY_LOGIN_FAIL_WINDOW=600
SECURITY_RAPID_REQUEST_THRESHOLD=60
SECURITY_OFF_HOURS_START=22
SECURITY_OFF_HOURS_END=6
SECURITY_UPLOAD_RATE_LIMIT=10
